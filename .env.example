# --- Shopify ---
SHOPIFY_SHOP=mojshop.myshopify.com
# Opcija A: Dev Dashboard app (preporučeno, od 2026. se novi "legacy" custom appovi ne mogu raditi u adminu)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Opcija B: postojeći custom app iz admina (token shpat_...)
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07

# --- Sidrena cijena ---
# variant:<namespace>.<key>  – metafield na varijanti
# product:<namespace>.<key>  – metafield na proizvodu
# (skripta pita oba mjesta, varijanta ima prednost)
# none                       – kolona ostaje prazna
# (tutorial: metafield varijante "sidrena cijena", tip Money, puni ga Flow na dan 1.10.2026.)
ANCHOR_METAFIELD=variant:custom.sidrena_cijena

# compare-at > cijena => artikl je na sniženju (poseban oblik prodaje)
SALE_FROM_COMPARE_AT=true

# Vendori koji su marke proizvoda (ostalima je kolona Marka prazna)
BRAND_VENDORS=Lotus Centar,New Science

# --- Izlaz ---
OUTPUT_DIR=/var/www/cjenik
PUBLIC_URL=https://cjenik.mojshop.hr
SHOP_NAME=Moj Shop d.o.o.
DEFAULT_UNIT=kom
CSV_DELIMITER=;
CSV_DECIMAL=,
ARCHIVE_DAYS=35
